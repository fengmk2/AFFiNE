{
  "name": "@blocksuite/integration-test",
  "description": "Integration test for BlockSuite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "test:unit": "vitest --browser.headless --run",
    "test:debug": "PWDEBUG=1 npx vitest"
  },
  "sideEffects": false,
  "keywords": [],
  "author": "toeverything",
  "license": "MIT",
  "dependencies": {
    "@blocksuite/affine": "workspace:*",
    "@blocksuite/icons": "catalog:",
    "@floating-ui/dom": "catalog:",
    "@lit/context": "catalog:",
    "@lottiefiles/dotlottie-wc": "catalog:",
    "@preact/signals-core": "catalog:",
