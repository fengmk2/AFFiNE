    "@vanilla-extract/css": "catalog:",
    "lit": "catalog:",
    "rxjs": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./effects": "./src/effects.ts",
    "./store": "./src/store.ts",
    "./view": "./src/view.ts"
  },
  "files": [
    "src",
    "dist",
    "themes",
    "!src/__tests__",
    "!dist/__tests__"
