{
  "name": "@affine/native",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "affine",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-pc-windows-msvc"
    ],
    "constEnum": false
  },
  "license": "MIT",
  "ava": {
    "extensions": {
      "mts": "module"
    },
    "files": [
      "__tests__/*.spec.mts"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "@napi-rs/whisper": "^0.0.4",
    "@types/node": "catalog:",
    "ava": "catalog:",
    "rxjs": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build -p affine_native --platform --release",
    "build:debug": "napi build -p affine_native --platform",
    "universal": "napi universal",
    "test": "ava",
    "version": "napi version"
  },
  "version": "0.25.5"
}
